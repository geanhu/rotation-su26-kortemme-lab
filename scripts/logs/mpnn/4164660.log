#!/bin/bash
#$ -S /bin/bash
#$ -q long.q
#$ -cwd
#$ -N mpnn
#$ -o logs/mpnn/$JOB_ID.log
#$ -j y
#$ -l h_rt=06:00:00
#$ -l mem_free=16G
#$ -l scratch=1G

# metadata
echo "Start: $(date)"
[[ -n "$JOB_ID" ]] && qstat -j "$JOB_ID"
echo "------Start of script-------"
cat "$0"
echo "-------End of script---------"

# setup env
module load CBI miniforge3
conda activate ligandmpnn

# run
python ~/software/LigandMPNN/run.py \
    --model_type "soluble_mpnn" \
    --checkpoint_soluble_mpnn "~/software/LigandMPNN/model_params/solublempnn_v_48_002.pt" \
    --pdb_path_multi '~/multi-state/data/string-sampling/5KPE-5KPH.json' \
    --out_folder '~/multi-state/data/mpnn-output/5KPE-5KPH/' \
    --seed 42 \
    --temperature 0.1 \
    --omit_AA "CH" \
    --batch_size 1 \
    --number_of_batches 8

#end
echo "End: $(date)"-------End of script---------
