#!/bin/bash
#$ -S /bin/bash
#$ -q long.q
#$ -cwd
#$ -N multi
#$ -o logs/misc/$JOB_ID.log
#$ -j y
#$ -l h_rt=04:00:00
#$ -l mem_free=8G
#$ -l scratch=1G
#$ -pe smp 8

# metadata
echo "Start: $(date)"
echo "$(hostname)"
[[ -n "$JOB_ID" ]] && qstat -j "$JOB_ID"
echo "------Start of script-------"
cat "$0"
echo "-------End of script---------"

# setup env
module load CBI miniforge3
conda activate pyrosetta

# run
python ~/multi-state/scripts/utils/pyrosetta-fastrelax-sidechains-score.py \
    '/wynton/home/rotation/geanhu/multi-state/data/mpnn-output/5KPE-5KPH_multi-state/temp1/backbones' \
    '/wynton/home/rotation/geanhu/multi-state/data/pyrosetta-output/5KPE-5KPH_multi-state/temp1'

#end
echo "End: $(date)"-------End of script---------
