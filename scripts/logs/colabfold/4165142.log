    --num-recycle 3 \
    --msa-mode single_sequence \
    --random-seed 42 \
    --num-seeds 1 \
    $HOME/mpnn-output/5KPE-5KPH_bias/seqs/seqs.csv \
    $HOME/multi-state/data/colabfold-output/5KPE-5KPH/

# end
echo "End: $(date)"
