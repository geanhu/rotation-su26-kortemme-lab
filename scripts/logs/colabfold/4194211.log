#!/bin/bash
#$ -S /bin/bash
#$ -q gpu.q
#$ -pe smp 1
#$ -l compute_cap=80,gpu_mem=40G
#$ -cwd
#$ -N fold
#$ -o logs/colabfold/$JOB_ID.log
#$ -j y
#$ -l h_rt=00:30:00
#$ -l mem_free=32G
#$ -l scratch=32G
#$ -l h=!qb3-idgpu18&!qb3-atgpu4

# metadata
echo "Start: $(date)"
echo "$(hostname)"
[[ -n "$JOB_ID" ]] && qstat -j "$JOB_ID"
echo "------Start of script-------"
cat "$0"
echo ""
echo "-------End of script---------"

# run
# exec colabfold_batch \
#     --num-recycle 3 \
#     --msa-mode single_sequence \
#     --random-seed 42 \
#     --num-seeds 1 \
#     $HOME/multi-state/data/mpnn-output/5KPE-5KPH_refined/seqs/seqs.csv \
#     $HOME/multi-state/data/colabfold-output/5KPE-5KPH_refined/

exec colabfold_batch \
    --num-recycle 3 \
    --msa-mode single_sequence \
    --random-seed 42 \
    --num-seeds 1 \
    $HOME/multi-state/data/mpnn-output/5KPE_higher-T/seqs/seqs.csv \
    $HOME/multi-state/data/colabfold-output/5KPE_higher-T/

# end
echo "End: $(date)"
echo "-----------"
