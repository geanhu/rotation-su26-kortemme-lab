#!/bin/bash
#$ -S /bin/bash
#$ -q gpu.q
#$ -pe smp 1
#$ -l compute_cap=61,gpu_mem=6000M
#$ -cwd
#$ -N diffusion
#$ -o logs/rfdiffusion/$JOB_ID.log
#$ -j y
#$ -l h_rt=06:00:00
#$ -l mem_free=32G
#$ -l scratch=32G
#$ -l h=!(qb3-idgpu18)
#$ -t 1-159

# metadata
echo "Start: $(date)"
[[ -n "$JOB_ID" ]] && qstat -j "$JOB_ID"
echo "------Start of script-------"
cat "$0"
echo "-------End of script---------"

# setup env
module load CBI miniforge3
conda activate SE3nv

# create array job settings
input_dir="$HOME/multi-state/data/string-sampling/end-states/"
pdb_list="${input_dir}/5kpe.txt"

if [! -f "$pdb_list"]; then
    find "$input_dir" -type f -name "5KPE*.pdb" | sort > "$pdb_list"
fi

PDB_FILE=$(sed -n "${SGE_TASK_ID}p" "$pdb_list")

# run
python ~/software/RFdiffusion/scripts/run_inference.py \
    inference.num_designs=1 \
    diffuser.partial_T=1 \
    'contigmap.contigs=[106-106]' \
    "inference.input_pdb=$PDB_FILE" \
    "inference.output_prefix=$HOME/multi-state/data/diffusion-output/5KPE-5KPH/$(basename $PDB_FILE .pdb)"

#end
echo "End: $(date)"-------End of script---------
